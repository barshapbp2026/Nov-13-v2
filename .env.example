# GEMINI_API_KEY_1..6 / GEMINI_API_KEYS: Required for Gemini AI API calls.
# Configuring multiple custom keys enables round-robin load balancing and quota failover.
# Default project GEMINI_API_KEY is intentionally not used. Configure your keys via Settings > Secrets.
GEMINI_API_KEY_1="MY_GEMINI_API_KEY_1"
GEMINI_API_KEY_2="MY_GEMINI_API_KEY_2"
GEMINI_API_KEY_3="MY_GEMINI_API_KEY_3"
GEMINI_API_KEY_4="MY_GEMINI_API_KEY_4"
GEMINI_API_KEY_5="MY_GEMINI_API_KEY_5"
GEMINI_API_KEY_6="MY_GEMINI_API_KEY_6"
# Or add all keys at once in a single secret (comma, space, or newline separated):
GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional GitHub Personal Access Token (read-only Contents scope).
# Required only when the upstream PDF repository is set to private so the server proxy can stream PDFs securely.
GITHUB_TOKEN="MY_GITHUB_TOKEN"
